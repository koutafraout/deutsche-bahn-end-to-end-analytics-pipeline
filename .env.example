# --- ingestion/monthly_load ---
HF_REPO_ID=piebro/deutsche-bahn-data
HF_MONTHLY_SUBFOLDER=monthly_processed_data
S3_BRONZE_BUCKET=deutsche-bahn-delay-data-lake
S3_BRONZE_PREFIX=bronze/monthly-raw

# --- AWS credentials (consumed by boto3; leave blank to use ~/.aws/credentials or an IAM role) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# --- warehouse/dbt (Redshift Serverless workgroup: deutsche-bahn-pipeline-wg) ---
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DBNAME=dev
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_SCHEMA=dbt_dev

# --- dashboard/setup_metabase.py ---
# Generate via Metabase UI: Settings -> Admin settings -> Settings -> API Keys
METABASE_URL=http://localhost:3000
METABASE_API_KEY=
